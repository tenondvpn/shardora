                  "value": "{{run_time_now}}",
                  "type": "text",
                  "disabled": false,
                  "description": "逗号分隔的 run_time，与 tasklist 按下标对应"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3.5 停止任务",
