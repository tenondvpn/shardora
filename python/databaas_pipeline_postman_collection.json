          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text",
                "description": "simplejwt 只认 Bearer。写成 'JWT <token>' 会 401 Authentication credentials were not provided。"
              }
            ],
            "url": "{{base_url}}/api/pipeline/history/set_task_success/",
            "description": "有真实副作用：绕过实际执行，直接把某次运行标记成成功。\n\n一般用于卡住的下游依赖解锁。路径带 history 前缀，别写成 /pipeline/set_task_success/。",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
