  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function __store() {",
          "    if (typeof pm !== 'undefined') {",
          "        if (pm.collectionVariables) { return pm.collectionVariables; }",
          "        if (pm.environmentVariables) { return pm.environmentVariables; }",
          "        if (pm.globals) { return pm.globals; }",
          "        if (typeof pm.environment !== 'undefined') { return pm.environment; }",
          "    }",
          "    return null;",
          "}",
          "function vGet(k) { var s = __store(); return s ? s.get(k) : undefined; }",
          "function vSet(k, v) { var s = __store(); if (s) { s.set(k, v); } }",
          "",
          "// 集合级前置脚本，每次请求前都会跑",
          "",
          "// 1) 明文密码 -> 三层 MD5，对齐前端登录前的变换",
          "//    md5(md5(md5(plain))) 小写十六进制 = 服务端存的值",
          "try {",
          "    var CryptoJS = require('crypto-js');",
          "    var plain = vGet('password_plain');",
          "    var h1 = CryptoJS.MD5(plain).toString();",
          "    var h2 = CryptoJS.MD5(h1).toString();",
          "    vSet('password_md5', CryptoJS.MD5(h2).toString());",
          "} catch (e) {",
          "    // 沙箱里没有 crypto-js 模块：沿用变量里预置好的 password_md5，不影响发送",
          "}",
          "",
          "// 2) run_time_now = 当前时间，12 位 YYYYMMDDHHMM（精确到分钟），执行类请求用它",
          "//    注意是到「分钟」不是到「小时」：平台记录出来的 run_time 长这样",
          "//    202609241438 / 202609241418，后两位是分钟数，不是补的 00。",
          "try {",
          "    var d = new Date();",
          "    var p = function (n) { return (n < 10 ? '0' : '') + n; };",
          "    vSet('run_time_now',",
          "        d.getFullYear() + p(d.getMonth() + 1) + p(d.getDate()) +",
          "        p(d.getHours()) + p(d.getMinutes()));",
          "} catch (e) {",
          "    console.log('算 run_time_now 失败，执行类请求请手动填日期: ' + e);",
          "}"
        ]
      }
    }
  ],
