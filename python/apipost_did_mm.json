    {
      "name": "0. 前置：查询账户（校验 nonce / 余额）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "address",
              "value": "{{prefund}}",
              "type": "text",
              "description": "改成 {{account}} 可查调用者本账户"
            }
          ]
        },
        "url": {
          "raw": "{{base}}/api/shard{{shard}}/query_account",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "shard{{shard}}",
            "query_account"
          ]
        },
        "description": "返回 text/plain 的 JSON 文本，含 nonce / balance / shardingId / latestHeight。\n\nprefund 账户行只有在创建或执行交易上链后才出现。刚部署完立即查询可能读到 'get address failed from cache'，需要重试。\n\n示例返回：\n{\"pubkey\":\"\",\"balance\":\"98014571\",\"shardingId\":3,\"poolIndex\":19,\"addr\":\"djVDO7ye2wGTlVW9eXGRaZhjgKGvF3C4rWxw4US1UI+MnUCsefkGWw==\",\"type\":\"kNormal\",\"latestHeight\":\"393\",\"txIndex\":0,\"nonce\":\"4\"}"
      }
    },
    {
      "name": "1. registerDID（注册 DID，写交易）",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 提交后轮询 prefund 的 nonce，确认是否上链。",
              "var t = pm.response.text().trim();",
              "if (t === 'ok') {",
              "  var tries = 0;",
              "  var poll = function () {",
              "    pm.sendRequest({",
              "      url: pm.variables.get('base') + '/api/shard' + pm.variables.get('shard') + '/query_account',",
              "      method: 'POST',",
              "      header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
              "      body: { mode: 'urlencoded', urlencoded: [",
              "        { key: 'address', value: pm.variables.get('prefund') }",
              "      ]}",
              "    }, function (err, res) {",
              "      if (err || !res) { return; }",
              "      var j = null;",
              "      try { j = JSON.parse(res.stream.toString()); } catch (e) { }",
              "      if (j && j.nonce === pm.variables.get('nonce')) {",
              "        console.log('已上链，prefund nonce = ' + j.nonce);",
              "      } else if (++tries < 10) {",
              "        setTimeout(poll, 3000);",
              "      } else {",
              "        console.warn('30 秒内未观察到 nonce 变化，请检查交易状态');",
              "      }",
              "    });",
              "  };",
              "  setTimeout(poll, 3000);",
              "}"
            ]
          }
        }
      ],
